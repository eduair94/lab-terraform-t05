# Terraform Block
# Sin AWS: la "EC2" es un contenedor Docker con SSH (ver c4-server.tf).
terraform {
  required_version = ">= 1.6"
  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
    null = {
      source  = "hashicorp/null"
      version = "~> 3.2"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.12"
    }
  }
}

# Usa el Docker local (Docker Desktop en Windows/macOS, /var/run/docker.sock en Linux)
provider "docker" {}
